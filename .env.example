# Choose "ollama" (default; local, no account needed) or "openrouter"
# (cloud, free-tier models available, needs an API key).
APP_MODEL_BACKEND=ollama

# --- Used when APP_MODEL_BACKEND=ollama ---
APP_OLLAMA_HOST=http://localhost:11434
APP_OLLAMA_MODEL=llama3.2

# --- Used when APP_MODEL_BACKEND=openrouter ---
# Get a key at https://openrouter.ai/keys and pick a current free model id
# from https://openrouter.ai/models?max_price=0 (format: provider/model:free).
APP_OPENROUTER_API_KEY=your-openrouter-api-key-here
APP_OPENROUTER_MODEL=provider/model-name:free
